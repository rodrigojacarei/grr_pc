# Port profile read by the packaging scripts and the CI: one file per port, same keys everywhere.
PORT_NAME="Gravity Rush Remastered" # executable, window and menu entry name
PORT_SLUG="grr"                     # package prefix: <slug>-linux-x86_64.tar.gz, <slug>-windows-x86_64.zip
PORT_LAUNCHER="grr_launcher_qt.py"            # port/launcher/<file>: the default launcher (Qt Quick), frozen with PyInstaller
PORT_LAUNCHER_CLASSIC="grr_launcher.py"       # port/launcher/<file>: the Tk launcher, shipped as "$PORT_NAME (classic)"
PORT_QT_PACKAGE="PySide6-Essentials==6.12.0"  # pinned for the package (launcher/qt/requirements.txt says >=6.7)
PORT_ICON="grr"                     # port/launcher/<icon>.png and .ico (original art, never the game's)
PORT_TITLE_ID="CUSA01130"
